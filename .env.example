# Провайдер модели: любой OpenAI-совместимый endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Папка с файлами кейса (docx резюме и вакансий); пусто — ./data/case
RVM_DATA_DIR=
# Ключ подписи сессий (пусто — случайный на запуск, вход сбросится при перезапуске)
RVM_SECRET=
# Домены стенда через запятую (localhost разрешён всегда)
RVM_ALLOWED_HOSTS=
# Вход по роли в один клик без пароля (только для демо-стенда)
RVM_DEMO_LOGIN=
# Хэши паролей учёток (scrypt, без $ — не ломают подстановку compose): uv run python -c "from rvm.api.auth import hash_password; print(hash_password('пароль'))"
RVM_PASSWORD_ANNA=
RVM_PASSWORD_OLEG=
# Загрузка вакансий с hh.ru: без User-Agent с контактом hh отвечает 403, формат «Название/версия (почта)»
RVM_HH_USER_AGENT=
# Входящие: опрос источников откликов раз в N минут (по умолчанию 5; 0 — только кнопка «Проверить сейчас»)
RVM_POLL_MINUTES=
# Источник «hh.ru»: отклики на открытые вакансии, импортированные с hh (только чтение).
# OAuth access token менеджера работодателя: приложение на dev.hh.ru, вход менеджером МФТИ
# (authorization code, docs/authorization_for_user.md в github.com/hhru/api); токен — только здесь
RVM_HH_TOKEN=
# Источник «папка»: файлы забираются и переносятся в done/ или error/ внутри неё;
# имя «<id вакансии>__резюме.docx» — отклик на эту вакансию
RVM_INBOX_DIR=
# Источник «почта» (IMAP): письма за последние 14 дней с вложениями-резюме, уже забранные повторно не
# берутся; после постановки в очередь — отметка «прочитано» (подсказка человеку);
# вакансия отклика — по названию открытой вакансии в теме письма. Пароль — только здесь, не в базе
RVM_IMAP_HOST=
RVM_IMAP_USER=
RVM_IMAP_PASSWORD=
# Папка ящика (пусто — INBOX)
RVM_IMAP_FOLDER=
# 1 — IMAP по SSL (порт 993), 0 — без SSL (143); порт можно задать явно
RVM_IMAP_SSL=
RVM_IMAP_PORT=
# «Сводка»: срок разбора отклика в днях и пояс календарных дней (пустыми не оставлять)
RVM_SLA_DAYS=2
RVM_TZ=Europe/Moscow
# Демо-почта (docker compose ... --profile mail): пароль ящика hr@rvm.local, по умолчанию demo
RVM_DEMO_MAIL_PASSWORD=
