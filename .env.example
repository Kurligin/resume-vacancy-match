# Провайдер модели: любой OpenAI-совместимый endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Папка с файлами кейса (docx резюме и вакансий)
RVM_DATA_DIR=
# Ключ подписи сессий (пусто — случайный на запуск, вход сбросится при перезапуске)
RVM_SECRET=
# Домены стенда через запятую (localhost разрешён всегда)
RVM_ALLOWED_HOSTS=
