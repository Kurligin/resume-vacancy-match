# Провайдер модели: любой OpenAI-совместимый endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Папка с файлами кейса (docx резюме и вакансий); пусто — ./data/case
RVM_DATA_DIR=
# Ключ подписи сессий (пусто — случайный на запуск, вход сбросится при перезапуске)
RVM_SECRET=
# Домены стенда через запятую (localhost разрешён всегда)
RVM_ALLOWED_HOSTS=
# Вход по роли в один клик без пароля (только для демо-стенда)
RVM_DEMO_LOGIN=
# Хэши паролей учёток (scrypt, без $ — не ломают подстановку compose): uv run python -c "from rvm.api.auth import hash_password; print(hash_password('пароль'))"
RVM_PASSWORD_ANNA=
RVM_PASSWORD_OLEG=
# Загрузка вакансий с hh.ru: без User-Agent с контактом hh отвечает 403, формат «Название/версия (почта)»
RVM_HH_USER_AGENT=
